#!/bin/bash
# omarchy:summary=Apply a wallpaper-extracted accent color to niri, GTK, and quickshell
# omarchy:args=<#rrggbb>

ACCENT="${1:-$(cat)}"
if [[ ! "$ACCENT" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
  echo "Usage: omarchy-theme-bg-colors-apply '#rrggbb'" >&2
  exit 1
fi

COLORS_TOML="$HOME/.config/zanken/current/theme/colors.toml"
NIRI_CONFIG="$HOME/.config/niri/config.kdl"
GTK_CSS="$HOME/.config/gtk-4.0/noctalia.css"

# Compute contrasting fg for GTK accent_fg_color
R=$((16#${ACCENT:1:2}))
G=$((16#${ACCENT:3:2}))
B=$((16#${ACCENT:5:2}))
LUM=$(( (R * 299 + G * 587 + B * 114) / 1000 ))
if (( LUM > 140 )); then
  ACCENT_FG="#0f0f0f"
else
  ACCENT_FG="#f0f0f0"
fi

# Patch colors.toml: color1 → sealRaw (bar highlight)
if [[ -f "$COLORS_TOML" ]]; then
  sed -i "s/^color1 = \"#[0-9A-Fa-f]*\"/color1 = \"$ACCENT\"/" "$COLORS_TOML"
fi

# Patch niri config: active-color in focus-ring + border; drop gradient
if [[ -f "$NIRI_CONFIG" ]]; then
  sed -i "/inactive-color/!s/active-color \"#[0-9A-Fa-f]*\"/active-color \"$ACCENT\"/g" "$NIRI_CONFIG"
  sed -i '/active-gradient /d' "$NIRI_CONFIG"
fi

# Patch GTK CSS accent colors
if [[ -f "$GTK_CSS" ]]; then
  sed -i "s/@define-color accent_color #[0-9A-Fa-f]*;/@define-color accent_color $ACCENT;/" "$GTK_CSS"
  sed -i "s/@define-color accent_bg_color #[0-9A-Fa-f]*;/@define-color accent_bg_color $ACCENT;/" "$GTK_CSS"
  sed -i "s/@define-color accent_fg_color #[0-9A-Fa-f]*;/@define-color accent_fg_color $ACCENT_FG;/" "$GTK_CSS"
fi

# Switch to the closest Yaru icon theme variant
ICON_VARIANT=$(python3 - "$ACCENT" <<'PYEOF'
import colorsys, sys
VARIANTS = {
    'Yaru-blue':          '#227BDA',
    'Yaru-magenta':       '#B05CB1',
    'Yaru-olive':         '#5D8923',
    'Yaru-prussiangreen': '#478887',
    'Yaru-purple':        '#806FCF',
    'Yaru-red':           '#CF4A60',
    'Yaru-sage':          '#728275',
    'Yaru-wartybrown':    '#95795E',
    'Yaru-yellow':        '#A67322',
}
accent = sys.argv[1]
ar, ag, ab = int(accent[1:3],16)/255, int(accent[3:5],16)/255, int(accent[5:7],16)/255
ah, as_, av = colorsys.rgb_to_hsv(ar, ag, ab)
best, best_dist = 'Yaru-blue', float('inf')
for name, color in VARIANTS.items():
    r, g, b = int(color[1:3],16)/255, int(color[3:5],16)/255, int(color[5:7],16)/255
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    dh = min(abs(ah - h), 1 - abs(ah - h))
    dist = dh * 2 + abs(as_ - s) * 0.5 + abs(av - v) * 0.3
    if dist < best_dist:
        best_dist, best = dist, name
print(best)
PYEOF
)

if [[ -n "$ICON_VARIANT" ]]; then
  # Preserve -dark suffix if current theme is dark
  CURRENT_THEME=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")
  [[ "$CURRENT_THEME" == *-dark ]] && ICON_VARIANT="${ICON_VARIANT}-dark"
  gsettings set org.gnome.desktop.interface icon-theme "$ICON_VARIANT" 2>/dev/null || true
fi

# Patch qt6ct palette: highlight (12), highlightedText (13), accent (21)
QT6CT_CONF="$HOME/.config/qt6ct/colors/noctalia.conf"
if [[ -f "$QT6CT_CONF" ]]; then
  python3 - "$ACCENT" "$ACCENT_FG" "$QT6CT_CONF" <<'PYEOF'
import sys, re
accent, fg, path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    content = f.read()
content = re.sub(
    r'^((active|inactive|disabled)_colors)=(.+)$',
    lambda m: m.group(1) + '=' + ', '.join(
        accent if i in (12, 21) else (fg if i == 13 else c.strip())
        for i, c in enumerate(m.group(3).split(','))
    ),
    content, flags=re.MULTILINE
)
with open(path, 'w') as f:
    f.write(content)
PYEOF
fi

# Reload Quickshell theme
qs -c desktop ipc call theme reload 2>/dev/null || true

# Reload niri config
niri msg action load-config-file 2>/dev/null || true
