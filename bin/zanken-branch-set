#!/bin/bash

# zanken:summary=Set the branch for Omarchy's git repository.
# zanken:args=<master|rc|dev>

if (($# == 0)); then
  echo "Usage: zanken-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $ZANKEN_PATH switch $branch
