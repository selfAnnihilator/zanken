#!/bin/bash

# zanken:summary=Edit, set, or reset About branding
# zanken:group=branding
# zanken:name=about
# zanken:args=<image|text|reset>
# zanken:examples=zanken branding about image | zanken branding about text | zanken branding about reset

set -euo pipefail

SOURCE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"

case "${1:-}" in
image)
  image=$(zanken-menu-file "Pick png/svg from $SOURCE_DIR" "${SOURCE_DIR}" "svg png")
  if [[ -n $image ]] && zanken-transcode-ascii "$image" ~/.config/zanken/branding/about.txt --width 54 --height 26; then
    zanken-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  zanken-launch-editor ~/.config/zanken/branding/about.txt >/dev/null 2>&1 && zanken-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$ZANKEN_PATH/icon.txt" ~/.config/zanken/branding/about.txt && zanken-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: zanken-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
