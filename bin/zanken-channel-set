#!/bin/bash

# zanken:summary=Set the Omarchy channel, which dictates what git branch and package repository is used.
# zanken:args=<stable|rc|edge|dev>
# zanken:requires-sudo=true

if (($# == 0)); then
  echo "Usage: zanken-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") zanken-branch-set "master" && zanken-refresh-pacman "stable" ;;
"rc") zanken-branch-set "rc" && zanken-refresh-pacman "rc" ;;
"edge") zanken-branch-set "master" && zanken-refresh-pacman "edge" ;;
"dev") zanken-branch-set "dev" && zanken-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

zanken-update -y
