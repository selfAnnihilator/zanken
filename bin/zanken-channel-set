#!/bin/bash

# zanken:summary=Switch the installed Zanken desktop release mode
# zanken:args=<stable|dev> [--fetch] [--version VERSION] [--adopt] [--allow-downgrade]
# zanken:examples=zanken channel set dev --fetch | zanken channel set stable --fetch

set -euo pipefail

COMMAND_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec "$COMMAND_DIR/zanken-release" switch "$@"
