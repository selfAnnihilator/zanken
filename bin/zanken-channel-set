#!/bin/bash

# zanken:summary=Set the Zanken git release channel
# zanken:args=<stable|rc|edge|dev>
# zanken:requires-sudo=true

if (($# == 0)); then
  echo "Usage: zanken-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") zanken-branch-set "main" ;;
"rc") zanken-branch-set "rc" ;;
"edge" | "dev") zanken-branch-set "dev" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

zanken-update -y
