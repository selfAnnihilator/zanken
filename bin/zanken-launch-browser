#!/bin/bash

# zanken:summary=Launch the default browser or the configurable Mod+B quick browser.
# zanken:args=[url] [--quick]

if [[ ${1:-} == "--quick" ]]; then
  browser_exec=$(zanken-default-quick-browser)
  shift

  if ! command -v "$browser_exec" >/dev/null; then
    echo "Configured quick browser is unavailable: $browser_exec" >&2
    exit 1
  fi
else
  default_browser=$(xdg-settings get default-web-browser)
  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
fi

if "$browser_exec" --help 2>/dev/null | grep -q MOZ_LOG; then
  private_flag="--private-window"
elif [[ $browser_exec =~ edge ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi

systemd-run --user --quiet --collect --unit="zanken-browser-$(date +%s%N)" \
  --property=StandardOutput=null --property=StandardError=null \
  uwsm-app -- "$browser_exec" "${@/--private/$private_flag}"
