#!/bin/bash

# zanken:summary=Launch an app or focus an existing window matching a pattern
# zanken:args=<window-pattern> <launch-command>

if (($# == 0)); then
  echo "Usage: zanken-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

if (($# == 1)); then
  exec zanken-niri-launch-or-focus "$1" uwsm-app -- "$1"
fi

exec zanken-niri-launch-or-focus "$@"
