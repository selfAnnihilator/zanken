#!/bin/bash

# zanken:summary=Resume the last Zellij workspace or start a fresh session
# zanken:args=[--new|session]

set -euo pipefail

if ! zanken-cmd-present zellij; then
  echo "Zellij is not installed. Install it with: zanken-pkg-add zellij" >&2
  exit 1
fi

# Avoid nesting multiplexers when this is called from an existing Zellij pane.
if [[ -n ${ZELLIJ:-} ]]; then
  exit 0
fi

(( $# <= 1 )) || { echo "Usage: zanken-launch-zellij [--new|session]" >&2; exit 2; }
fresh=false
if [[ ${1:-} == "--new" ]]; then
  read -r fresh_id < /proc/sys/kernel/random/uuid
  session_name="work-$(date +%Y%m%d-%H%M%S)-${fresh_id%%-*}"
  fresh=true
elif [[ -n ${1:-} ]]; then
  session_name=$1
else
  session_name=$(zanken-cmd-zellij-session last)
  if [[ -z $session_name ]]; then
    session_name=main
    fresh=true
  fi
fi
# A final-tab close may still be clearing the old resurrection snapshot.
# Wait for that operation before deciding whether to attach or create.
umask 077
exec 9>"${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/zanken-zellij-session-$session_name.lock"
flock --shared 9
exec 9>&-
zanken-cmd-zellij-session remember "$session_name"
if [[ $fresh == "true" ]]; then
  exec zellij --session "$session_name"
fi
exec zellij attach --create "$session_name"
