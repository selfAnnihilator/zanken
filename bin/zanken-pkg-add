#!/bin/bash

# zanken:summary=Install Arch packages if they are missing
# zanken:args=<packages...>
# zanken:examples=zanken pkg add jq ripgrep
# zanken:requires-sudo=true

pacman_packages=()
aur_packages=()

for pkg in "$@"; do
  # --needed is too late to prevent AUR provider/conflict resolution.
  pacman -T "$pkg" &>/dev/null && continue
  if pacman -Si "$pkg" &>/dev/null; then
    pacman_packages+=("$pkg")
  else
    aur_packages+=("$pkg")
  fi
done

if (( ${#pacman_packages[@]} > 0 )); then
  sudo pacman -S --noconfirm --needed "${pacman_packages[@]}" || exit 1
fi

if (( ${#aur_packages[@]} > 0 )); then
  zanken-pkg-aur-add "${aur_packages[@]}" || exit 1
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -T "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
