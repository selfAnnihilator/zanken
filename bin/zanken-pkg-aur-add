#!/bin/bash

# zanken:summary=Add the named packages to the system from the AUR if they're missing. Returns false if it couldn't be done.
# zanken:args=<packages...>

missing=()
for pkg in "$@"; do
  pacman -T "$pkg" &>/dev/null || missing+=("$pkg")
done
if (( ${#missing[@]} > 0 )); then
  yay -S --noconfirm --needed --cleanafter "${missing[@]}" || exit 1
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -T "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
