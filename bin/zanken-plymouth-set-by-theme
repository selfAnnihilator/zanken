#!/bin/bash

# zanken:summary=Set the Plymouth boot theme from an Zanken theme
# zanken:args=<theme-name>
# zanken:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via zanken-plymouth-set.

if [[ $# -ne 1 ]]; then
  echo "Usage: zanken-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

theme=$1

if [[ -d ~/.config/zanken/themes/$theme ]]; then
  theme_dir=~/.config/zanken/themes/$theme
else
  theme_dir="$ZANKEN_PATH/themes/$theme"
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec zanken-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
