#!/bin/bash

# zanken:summary=Reinstall the stable Omarchy source directory from git

set -e
ZANKEN_PATH="${ZANKEN_PATH:-$HOME/zanken}"

# Reinstall the Omarchy configuration directory from the git source.

git clone --depth=1 --branch master "https://github.com/selfAnnihilator/zanken.git" ~/zanken-new >/dev/null
mv "$ZANKEN_PATH" "$HOME/zanken-old"
mv "$HOME/zanken-new" "$ZANKEN_PATH"
