#!/bin/bash

# zanken:summary=Install all default Zanken packages
# zanken:requires-sudo=true

set -e

# Ensure all packages are installed from the configured official repositories
# or the AUR. Do not overwrite pacman configuration or force downgrades.
mapfile -t packages < <(grep -v '^#' "$ZANKEN_PATH/install/zanken-base.packages" | grep -v '^$')
zanken-pkg-add "${packages[@]}"
