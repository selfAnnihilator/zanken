#!/bin/bash
# zanken:summary=Set a reminder via fzf (no walker required)

minutes=$(printf '%s\n' 1 2 5 10 15 20 30 45 60 90 120 | \
  fzf --prompt="Remind in minutes › " --layout=reverse --height=30%)
[[ -z $minutes ]] && exit 0

printf 'Reminder message (Enter to skip): '
read -r message

if [[ -n $message ]]; then
  zanken-reminder "$minutes" "$message"
else
  zanken-reminder "$minutes"
fi
