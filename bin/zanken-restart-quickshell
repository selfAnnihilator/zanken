#!/bin/bash
# zanken:summary=Restart the Quickshell desktop
# zanken:group=restart

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
config_name=zanken

if [[ ! -f $CONFIG_HOME/quickshell/zanken/shell.qml ]]; then
  config_name=desktop
fi

# Prefer Quickshell's soft reload. It preserves the MPRIS service connection,
# so paused browser media does not resume or advance while the shell reloads.
if [[ $config_name == "zanken" ]]; then
  reload_output=$(timeout 5 qs -c zanken ipc call zanken reload 2>&1)
  reload_status=$?
  if (( reload_status == 0 )) && [[ -z $reload_output ]]; then
    exit 0
  fi
fi

pkill -f 'qs.*-c.*zanken' 2>/dev/null || true
pkill -f 'qs.*-c.*desktop' 2>/dev/null || true
pkill -f 'systemd-inhibit.*zanken' 2>/dev/null || true
sleep 0.3
QT_QPA_PLATFORMTHEME=qt6ct setsid /usr/bin/qs -n -d -c "$config_name" >/dev/null 2>&1 &
