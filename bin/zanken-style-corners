#!/bin/bash

# zanken:summary=Set corners to sharp or round
# zanken:args=<sharp|round>
# zanken:examples=zanken style corners round | zanken style corners sharp

if [[ $1 != "sharp" && $1 != "round" ]]; then
  echo "Usage: zanken-style-corners <sharp|round>"
  exit 1
fi

case $1 in
  sharp) zanken-notification-send "Sharp corners enabled" -g 󰝣 ;;
  round) zanken-notification-send "Round corners enabled" -g 󰘇 ;;
esac
