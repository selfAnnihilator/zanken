#!/bin/bash

# zanken:summary=Lock the computer and turn off the display
# zanken:group=system
# zanken:name=lock
# zanken:examples=zanken system lock

LOCK_SCRIPT="$HOME/.local/share/qylock/quickshell-lockscreen/lock.sh"
LOCK_QML="$HOME/.local/share/qylock/quickshell-lockscreen/lock_shell.qml"

current_session_id() {
    loginctl list-sessions --no-legend 2>/dev/null | awk -v user="$USER" '$3 == user { print $1; exit }'
}

current_session_locked() {
    local session_id
    session_id="$(current_session_id)"
    [[ -n "$session_id" ]] && [[ "$(loginctl show-session "$session_id" -p LockedHint --value 2>/dev/null)" == "yes" ]]
}

if pgrep -u "$USER" -f "$LOCK_QML" >/dev/null; then
    if current_session_locked; then
        exit 0
    fi

    pkill -u "$USER" -f "$LOCK_QML" 2>/dev/null || true
    pkill -u "$USER" -f "$LOCK_SCRIPT" 2>/dev/null || true
    sleep 0.2
fi

if ! pgrep -u "$USER" -f "$LOCK_QML" >/dev/null; then
    bash "$LOCK_SCRIPT" &
fi

# Lock 1password if running
if pgrep -x "1password" >/dev/null; then
    1password --lock &
fi

if [[ ${OMARCHY_LOCK_ONLY:-false} != "true" ]]; then
    (
        sleep 3
        pgrep -u "$USER" -f "$LOCK_QML" >/dev/null || exit 0
        zanken-brightness-keyboard off
        zanken-brightness-display off
    ) &
fi
