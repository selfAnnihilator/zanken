#!/bin/bash

# zanken:summary=Set the current background image
# zanken:args=<path-to-image>
# zanken:examples=omarchy theme bg set ~/Pictures/background.png

if [[ -z $1 ]]; then
  echo "Usage: zanken-theme-bg-set <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$(realpath "$1")"
CURRENT_BACKGROUND_LINK="$HOME/.config/zanken/current/background"

if [[ ! -f "$BACKGROUND" ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

ext="${BACKGROUND##*.}"
case "${ext,,}" in
  mp4|webm|mkv|avi|mov|gif)
    pkill -x swaybg 2>/dev/null
    pkill -x mpvpaper 2>/dev/null
    setsid mpvpaper -o "loop=yes no-audio hwdec=auto" '*' "$CURRENT_BACKGROUND_LINK" \
      >/dev/null 2>&1 &

    if command -v zanken-wallpaper-colors &>/dev/null && command -v ffmpeg &>/dev/null; then
      FRAME=$(mktemp --suffix=.jpg)
      if ffmpeg -ss 3 -i "$BACKGROUND" -vframes 1 -q:v 2 "$FRAME" -y >/dev/null 2>&1; then
        ACCENT=$(zanken-wallpaper-colors "$FRAME" 2>/dev/null)
        if [[ "$ACCENT" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
          zanken-theme-bg-colors-apply "$ACCENT" &
        fi
      fi
      rm -f "$FRAME"
    fi
    ;;
  *)
    pkill -x mpvpaper 2>/dev/null
    pkill -x swaybg 2>/dev/null
    setsid swaybg -i "$CURRENT_BACKGROUND_LINK" -m fill >/dev/null 2>&1 &

    if command -v zanken-wallpaper-colors &>/dev/null; then
      ACCENT=$(zanken-wallpaper-colors "$BACKGROUND" 2>/dev/null)
      if [[ "$ACCENT" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        zanken-theme-bg-colors-apply "$ACCENT" &
      fi
    fi
    ;;
esac
