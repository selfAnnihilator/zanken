#!/bin/bash

# zanken:summary=Open the Omarchy background switcher
# zanken:group=theme
# zanken:name=bg-switcher
# zanken:aliases=zanken background

ZANKEN_PATH=${ZANKEN_PATH:-$HOME/zanken}
current_background=$(readlink -f "$HOME/.config/zanken/current/background" 2>/dev/null)

selected=$(zanken-menu-images \
  --lazy-thumbnails \
  --selected "$current_background" \
  "$HOME/Pictures/wallpaper")

if [[ -n "$selected" ]]; then
  zanken-theme-bg-set "$selected"
fi
