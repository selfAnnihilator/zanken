#!/bin/bash

# zanken:summary=Apply an Zanken theme
# zanken:args=<theme-name>
# zanken:examples=zanken theme list | zanken theme set "Tokyo Night"

if [[ -z $1 ]]; then
  echo "Usage: zanken-theme-set <theme-name>"
  exit 1
fi

CURRENT_THEME_PATH="$HOME/.config/zanken/current/theme"
NEXT_THEME_PATH="$HOME/.config/zanken/current/next-theme"
USER_THEMES_PATH="$HOME/.config/zanken/themes"
ZANKEN_THEMES_PATH="$ZANKEN_PATH/themes"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

if [[ ! -d $ZANKEN_THEMES_PATH/$THEME_NAME ]] && [[ ! -d $USER_THEMES_PATH/$THEME_NAME ]]; then
  echo "Theme '$THEME_NAME' does not exist"
  exit 1
fi

# Setup clean next theme directory (for atomic theme config swapping)
rm -rf "$NEXT_THEME_PATH"
mkdir -p "$NEXT_THEME_PATH"

# Copy official theme first, then overlay user customizations on top
cp -r "$ZANKEN_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null
cp -r "$USER_THEMES_PATH/$THEME_NAME/"* "$NEXT_THEME_PATH/" 2>/dev/null

# Generate colors.toml from alacritty.toml if theme is missing colors.toml
if [[ ! -f $NEXT_THEME_PATH/colors.toml && -f $NEXT_THEME_PATH/alacritty.toml ]]; then
  zanken-theme-colors-from-alacritty "$NEXT_THEME_PATH"
fi

# Generate dynamic configs
zanken-theme-set-templates

# Swap next theme in as current
rm -rf "$CURRENT_THEME_PATH"
mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

# Store theme name for reference
echo "$THEME_NAME" >"$HOME/.config/zanken/current/theme.name"

# Change background with theme
if [[ $ZANKEN_THEME_SKIP_BACKGROUND != "1" ]]; then
  zanken-theme-bg-next
fi

# Restart components to apply new theme
zanken-restart-swayosd
zanken-restart-terminal
niri msg action load-config-file 2>/dev/null || true
zanken-restart-quickshell
zanken-restart-btop
zanken-restart-opencode
zanken-restart-helix

# Change app-specific themes
zanken-theme-set-foot
zanken-theme-set-gnome
zanken-theme-set-browser
zanken-theme-set-vscode
zanken-theme-set-obsidian
zanken-theme-set-keyboard

# Call hook on theme set
zanken-hook theme-set "$THEME_NAME" >/dev/null

# Warm the background selector cache after the theme is applied, off the critical path.
zanken-theme-bg-cache >/dev/null 2>&1 &
