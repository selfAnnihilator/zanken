#!/bin/bash
# zanken:summary=Apply GTK/GNOME color-scheme for current theme
# zanken:hidden=true

THEME_DIR="$HOME/.config/zanken/current/theme"

if [ -f "$THEME_DIR/light.mode" ]; then
    gsettings set org.gnome.desktop.interface color-scheme 'default'
    gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3'
else
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
fi

# Deploy GTK4 theme CSS so file manager and other GTK4 apps pick up theme colors
if [ -f "$THEME_DIR/gtk4.css" ]; then
    cp "$THEME_DIR/gtk4.css" "$HOME/.config/gtk-4.0/zanken-theme.css"
fi
