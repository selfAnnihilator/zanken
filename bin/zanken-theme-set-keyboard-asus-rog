#!/bin/bash

# zanken:summary=Apply the current theme keyboard color to ASUS ROG keyboards
# zanken:hidden=true

ASUSCTL_THEME=~/.config/zanken/current/theme/keyboard.rgb

if zanken-cmd-present asusctl && [[ -f $ASUSCTL_THEME ]]; then
  hex=$(cat "$ASUSCTL_THEME")
  if [[ ! $hex =~ ^#?[[:xdigit:]]{6}$ ]]; then
    echo "Invalid ASUS keyboard color: expected exactly 6 hexadecimal digits" >&2
    exit 1
  fi

  asusctl aura effect static -c "${hex#\#}"
fi
