#!/bin/bash

# zanken:summary=Apply the current theme keyboard color to Framework Laptop 16 keyboards
# zanken:hidden=true

FRAMEWORK16_THEME=~/.config/zanken/current/theme/keyboard.rgb

if zanken-cmd-present qmk_hid && [[ -f $FRAMEWORK16_THEME ]]; then
  hex=$(cat "$FRAMEWORK16_THEME")
  if [[ ! $hex =~ ^#?[[:xdigit:]]{6}$ ]]; then
    echo "Invalid Framework keyboard color: expected exactly 6 hexadecimal digits" >&2
    exit 1
  fi
  hex="${hex#\#}"

  # Convert hex to QMK HSV (0-255 scale) using Python's colorsys
  read -r h s < <(python3 -c '
import colorsys
import sys
hex_color = sys.argv[1]
r, g, b = int(hex_color[:2],16)/255, int(hex_color[2:4],16)/255, int(hex_color[4:6],16)/255
h, s, v = colorsys.rgb_to_hsv(r, g, b)
print(int(h * 255), int(s * 255))
' "$hex")

  qmk_hid via --rgb-effect 1 2>/dev/null
  qmk_hid via --rgb-hue "$h" 2>/dev/null
  qmk_hid via --rgb-saturation "$s" 2>/dev/null
  qmk_hid via --rgb-brightness 100 2>/dev/null
  qmk_hid via --save 2>/dev/null
fi
