#!/bin/bash

# zanken:summary=Toggle nightlight screen temperature on Niri
# zanken:examples=zanken toggle nightlight

ON_TEMP=4000
OFF_TEMP=6000

if pgrep -x wlsunset >/dev/null; then
  pkill -x wlsunset
  zanken-notification-send -g "" "Daylight screen temperature"
else
  # Equal high and low temperatures make wlsunset apply a constant tint. The
  # explicit manual schedule avoids depending on GeoClue or a saved location.
  setsid wlsunset -t "$ON_TEMP" -T "$ON_TEMP" -S 00:00 -s 00:01 >/dev/null 2>&1 &
  zanken-notification-send -g "" "Nightlight screen temperature"
fi
