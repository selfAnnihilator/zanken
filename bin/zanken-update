#!/bin/bash
# zanken:summary=Update the Zanken repository
# zanken:group=update

set -euo pipefail

ZANKEN_PATH=${ZANKEN_PATH:-$HOME/zanken}

git -C "$ZANKEN_PATH" pull --ff-only
zanken-config-desktop sync

if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  zanken-restart-quickshell
  sleep 1

  if ! pgrep -f 'qs.*-c.*zanken' >/dev/null; then
    zanken-config-desktop rollback
    zanken-restart-quickshell
    echo "Quickshell failed after the update; restored the previous desktop configuration" >&2
    exit 1
  fi
fi
