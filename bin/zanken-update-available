#!/bin/bash
# zanken:summary=Check whether a Zanken update is available
# zanken:group=update
# zanken:hidden=true

# Checks if zanken has unpulled commits on the remote.
# Exit 0 = up to date; non-zero = updates available (bar shows badge).
git -C "$HOME/zanken" fetch --quiet 2>/dev/null || exit 0
LOCAL=$(git -C "$HOME/zanken" rev-parse HEAD 2>/dev/null) || exit 0
REMOTE=$(git -C "$HOME/zanken" rev-parse '@{u}' 2>/dev/null) || exit 0
[ "$LOCAL" != "$REMOTE" ] && echo "Zanken update available" && exit 1
exit 0
