#!/bin/bash
# zanken:summary=Check for an update to the installed release mode
# zanken:group=update
# zanken:hidden=true

set -euo pipefail

# Preserve the bar's 0=current / 1=available convention. Errors use exit 2.
COMMAND_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
result=$("$COMMAND_DIR/zanken-release" check --fetch) || exit 2
if [[ $(jq -r '.available' <<<"$result") == "true" ]]; then
  echo "Zanken update available"
  exit 1
fi
