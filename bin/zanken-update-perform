#!/bin/bash

# zanken:summary=Run the full Omarchy update pipeline
# zanken:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch 'hl.dsp.window.tag({ tag = "+noidle" })' &>/dev/null || hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
zanken-update-keyring
zanken-update-available-reset
zanken-update-system-pkgs
zanken-migrate
zanken-update-aur-pkgs
zanken-update-orphan-pkgs
zanken-hook post-update

zanken-update-analyze-logs

zanken-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch 'hl.dsp.window.tag({ tag = "-noidle" })' &>/dev/null || hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
