#!/bin/bash

# zanken:summary=Clean up the Voxtype status child process

trap 'kill 0' EXIT

if zanken-cmd-present voxtype; then
  voxtype status --follow --extended --format json | while read -r line; do
    echo "$line" | jq -c '. + {alt: .class}'
  done
else
  echo '{"alt": "", "tooltip": ""}'
fi
