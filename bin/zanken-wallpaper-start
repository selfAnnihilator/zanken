#!/bin/bash

# zanken:summary=Start the correct wallpaper renderer based on current background type

WE_MARKER="$HOME/.config/zanken/current/we-wallpaper"
if [[ -f "$WE_MARKER" ]]; then
  WE_DIR=$(< "$WE_MARKER")
  if [[ -d "$WE_DIR" ]]; then
    exec zanken-theme-we-set "$WE_DIR"
  fi
  rm -f "$WE_MARKER"
fi

LINK="$HOME/.config/zanken/current/background"

[[ -e "$LINK" ]] || exit 0

REAL=$(readlink -f "$LINK")
ext="${REAL##*.}"

case "${ext,,}" in
  mp4|webm|mkv|avi|mov|gif)
    exec mpvpaper -o "loop=yes no-audio hwdec=auto" '*' "$LINK"
    ;;
  *)
    exec swaybg -i "$LINK" -m fill
    ;;
esac
