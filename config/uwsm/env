# Changes require a restart to take effect.

# Keep the inherited OMARCHY_PATH variable as a compatibility alias while
# third-party and user scripts finish moving to Zanken names.
export ZANKEN_PATH=$HOME/zanken
export OMARCHY_PATH=$ZANKEN_PATH
export PATH=$ZANKEN_PATH/bin:$PATH:$HOME/.local/bin

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
zanken-cmd-present mise && eval "$(mise activate bash --shims)"
