+// Match the configured menu, including local WASM extensions, without depending
+// on which input mode follows the launch action.
+fn menu_hint_key(keymap: &[(KeyWithModifier, Vec<Action>)], name: &str) -> Vec<KeyWithModifier> {
+    keymap.iter().filter_map(|(key, actions)| {
+        actions.iter().any(|action| {
+            match action {
+                Action::LaunchPlugin { plugin, .. } | Action::LaunchOrFocusPlugin { plugin, .. } => {
+                    let location = plugin.location_string();
+                    location == name || location == format!("zellij:{}", name)
+                        || location.ends_with(&format!("/{}.wasm", name))
+                },
+                _ => false,
+            }
+        }).then(|| key.clone())
+    }).collect()
+}
+
+// Prefix hints follow the configured helper actions instead of fixed key names.
+fn helper_hint_key(keymap: &[(KeyWithModifier, Vec<Action>)], name: &str) -> Vec<KeyWithModifier> {
+    keymap.iter().filter_map(|(key, actions)| {
+        actions.iter().any(|action| match action {
+            Action::KeybindPipe { name: message, .. } if name == "close" => {
+                message.as_deref() == Some("zanken-close-focus")
+                    // Zellij omits pipe metadata from ModeInfo. In this
+                    // workspace only the unmodified prefix x is its close pipe.
+                    || (message.is_none() && key.key_modifiers.is_empty()
+                        && key.bare_key == BareKey::Char('x'))
+            },
+            Action::Run { command, .. }
+            | Action::NewFloatingPane { command: Some(command), .. }
+            | Action::NewTiledPane { command: Some(command), .. } => {
+                command.command.file_name().and_then(|value| value.to_str()) == Some("zanken-cmd-zellij-session")
+                    && command.args.first().map(String::as_str) == Some(name)
+            },
+            _ => false,
+        }).then(|| key.clone())
+    }).collect()
+}
