+use zellij_tile::prelude::*;
+
+pub fn arrows(mut key: KeyWithModifier) -> KeyWithModifier {
+    if key.has_no_modifiers() {
+        key.bare_key = match key.bare_key {
+            BareKey::Char('h') => BareKey::Left,
+            BareKey::Char('j') => BareKey::Down,
+            BareKey::Char('k') => BareKey::Up,
+            BareKey::Char('l') => BareKey::Right,
+            other => other,
+        };
+    }
+    key
+}
+
+pub fn footer(row: usize, cols: usize, hint: &str) {
+    let text: String = hint.chars().take(cols).collect();
+    print_text_with_coordinates(Text::new(text).color_all(2), 0, row, Some(cols), None);
+}
