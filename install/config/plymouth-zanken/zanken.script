# Zanken Plymouth Theme

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# ── Pre-load logo frames (logo.png = clean, logo_01..16 = shine sweep) ──
frames[0]  = Image("logo.png");
frames[1]  = Image("logo_01.png");
frames[2]  = Image("logo_02.png");
frames[3]  = Image("logo_03.png");
frames[4]  = Image("logo_04.png");
frames[5]  = Image("logo_05.png");
frames[6]  = Image("logo_06.png");
frames[7]  = Image("logo_07.png");
frames[8]  = Image("logo_08.png");
frames[9]  = Image("logo_09.png");
frames[10] = Image("logo_10.png");
frames[11] = Image("logo_11.png");
frames[12] = Image("logo_12.png");
frames[13] = Image("logo_13.png");
frames[14] = Image("logo_14.png");
frames[15] = Image("logo_15.png");
frames[16] = Image("logo_16.png");

global.FRAME_COUNT  = 17;   # 0 = clean, 1-16 = shine
global.SHINE_PAUSE  = 180;  # ~3.6 s hold between sweeps (at 50 fps)
global.FRAME_SPEED  = 2;    # advance shine frame every N ticks (~25 fps sweep)

logo.sprite = Sprite(frames[0]);
logo.x = Window.GetWidth()  / 2 - frames[0].GetWidth()  / 2;
logo.y = Window.GetHeight() / 2 - frames[0].GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 1);

global.anim_tick    = 0;
global.shine_frame  = 0;   # 0 = idle/clean, 1-16 = sweep in progress
global.wait_ticks   = 0;

# ── Progress bar ─────────────────────────────────────────────────
global.fake_progress_limit    = 0.7;
global.fake_progress_duration = 15.0;
global.animation_frame        = 0;
global.fake_progress          = 0.0;
global.real_progress          = 0.0;
global.fake_progress_active   = 0;
global.fake_progress_start_time = 0.0;
global.password_shown         = 0;
global.max_progress           = 0.0;

progress_box.image   = Image("progress_box.png");
progress_box.sprite  = Sprite(progress_box.image);
progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite  = Sprite();
progress_bar.image   = progress_bar.original_image.Scale(1, progress_bar.original_image.GetHeight());

entry_y = logo.y + frames[0].GetHeight() + 40;

progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = entry_y + 10;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);
progress_box.sprite.SetOpacity(0);

progress_bar.x = Window.GetWidth() / 2 - progress_bar.original_image.GetWidth() / 2;
progress_bar.y = progress_box.y + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);
progress_bar.sprite.SetOpacity(0);

fun update_progress_bar(progress) {
  if (progress > global.max_progress) {
    global.max_progress = progress;
    width = Math.Int(progress_bar.original_image.GetWidth() * progress);
    if (width < 1) width = 1;
    progress_bar.image = progress_bar.original_image.Scale(width, progress_bar.original_image.GetHeight());
    progress_bar.sprite.SetImage(progress_bar.image);
  }
}

fun show_progress_bar() { progress_box.sprite.SetOpacity(1); progress_bar.sprite.SetOpacity(1); }
fun hide_progress_bar() { progress_box.sprite.SetOpacity(0); progress_bar.sprite.SetOpacity(0); }

# ── Password dialog ──────────────────────────────────────────────
lock.image   = Image("lock.png");
entry.image  = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = entry_y;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

lock_height = entry.image.GetHeight() * 0.8;
lock_scale  = lock_height / 96;
lock_width  = 84 * lock_scale;
scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.sprite.SetPosition(entry.x - lock_width - 15,
                        entry.y + entry.image.GetHeight() / 2 - lock_height / 2,
                        10001);
lock.sprite.SetOpacity(0);

bullet.sprites = [];

fun show_password_dialog() { lock.sprite.SetOpacity(1); entry.sprite.SetOpacity(1); }
fun hide_password_dialog() {
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (i = 0; bullet.sprites[i]; i++) bullet.sprites[i].SetOpacity(0);
}

# ── Refresh callback ─────────────────────────────────────────────
fun refresh_callback() {
  global.animation_frame++;
  global.anim_tick++;

  # Fake progress
  if (global.fake_progress_active == 1) {
    elapsed = global.animation_frame / 50.0;
    ratio   = elapsed / global.fake_progress_duration;
    if (ratio > 1.0) ratio = 1.0;
    eased   = 1 - ((1 - ratio) * (1 - ratio));
    global.fake_progress = eased * global.fake_progress_limit;
    update_progress_bar(global.fake_progress);
  }

  # Shine animation
  if (global.shine_frame == 0) {
    # Idle: waiting to start next sweep
    global.wait_ticks++;
    if (global.wait_ticks >= global.SHINE_PAUSE) {
      global.shine_frame = 1;
      global.wait_ticks  = 0;
      global.anim_tick   = 0;
      logo.sprite.SetImage(frames[1]);
    }
  } else {
    # Sweep in progress
    if (global.anim_tick >= global.FRAME_SPEED) {
      global.anim_tick = 0;
      global.shine_frame++;
      if (global.shine_frame >= global.FRAME_COUNT) {
        global.shine_frame = 0;
        logo.sprite.SetImage(frames[0]);
      } else {
        logo.sprite.SetImage(frames[global.shine_frame]);
      }
    }
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

# ── Boot callbacks ────────────────────────────────────────────────
fun display_normal_callback() {
  hide_password_dialog();
  mode = Plymouth.GetMode();
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    show_progress_bar();
  }
}

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  hide_progress_bar();
  show_password_dialog();
  for (i = 0; bullet.sprites[i]; i++) bullet.sprites[i].SetOpacity(0);
  max_b = 21;
  n = bullets; if (n > max_b) n = max_b;
  for (i = 0; i < n; i++) {
    if (!bullet.sprites[i]) {
      sb = bullet.image.Scale(7, 7);
      bullet.sprites[i] = Sprite(sb);
      bullet.sprites[i].SetPosition(entry.x + 20 + i * 12,
                                    entry.y + entry.image.GetHeight() / 2 - 3,
                                    10002);
    }
    bullet.sprites[i].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun progress_callback(duration, progress) {
  if (global.fake_progress_start_time == 0.0) global.fake_progress_start_time = duration;
  global.real_progress = progress;
  if (duration > global.fake_progress_start_time && progress > global.fake_progress) {
    global.fake_progress_active = 0;
    update_progress_bar(progress);
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ── Message ───────────────────────────────────────────────────────
msg_sprite = Sprite();
msg_sprite.SetPosition(10, 10, 10000);
fun display_message_callback(text) {
  msg_sprite.SetImage(Image.Text(text, 1, 1, 1));
  msg_sprite.SetOpacity(1);
}
fun hide_message_callback(text) { msg_sprite.SetOpacity(0); }
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
